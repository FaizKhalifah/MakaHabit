<% layout('../views/layouts/main') %>
<link rel="stylesheet" href="/css/habit.css">

<section class="habit-form">
  <h2>Edit Habit</h2>

  <form method="POST" action="/habits/edit/<%= habit._id %>">
    <div class="form-group">
      <label>Title</label>
      <input type="text" name="title" value="<%= habit.title %>" required>
    </div>

    <div class="form-group">
      <label>Description</label>
      <textarea name="description"><%= habit.description %></textarea>
    </div>

    <div class="form-group">
      <label>Frequency</label>
      <select name="frequency" required>
        <option value="daily" <%= habit.frequency === 'daily' ? 'selected' : '' %>>Daily</option>
        <option value="weekly" <%= habit.frequency === 'weekly' ? 'selected' : '' %>>Weekly</option>
        <option value="monthly" <%= habit.frequency === 'monthly' ? 'selected' : '' %>>Monthly</option>
      </select>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Update Habit</button>
      <a href="/habits" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</section>
